# URL dasar API backend (tanpa trailing slash).
# Contoh lokal: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Client key Midtrans Snap (dari dashboard Midtrans).
VITE_MIDTRANS_CLIENT_KEY=

# Set "true" untuk lingkungan produksi Midtrans, biarkan kosong/"false" untuk sandbox.
VITE_MIDTRANS_IS_PRODUCTION=false
