# ─── Railway production env ─────────────────────────────────────────────────
# Cara pakai: salin nilai ini ke Railway service → Variables.
# Nilai database memakai REFERENCE VARIABLE ke plugin MySQL Railway,
# misalnya DB_HOST=${{MySQL.MYSQLHOST}} — sintaks ${{...}} hanya berlaku
# di dashboard Railway, BUKAN di file .env.

APP_NAME="Cantik itu Pilihan"
APP_ENV=production
# Generate: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://simple-booking-mua.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr supaya log terlihat di Railway → Deploy Logs
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Di Railway cukup satu variabel: DB_URL=${{MySQL.MYSQL_URL}}
# (Laravel parse mysql://user:pass@host:port/db otomatis).
# Alternatif per-field: DB_HOST=${{MySQL.MYSQLHOST}}, dst.
DB_CONNECTION=mysql
DB_URL=${MYSQL_URL}

# Browser session store. JANGAN pakai `database`: tabel `sessions` di project ini
# adalah tabel opaque auth token (ERD), bukan tabel session Laravel.
# `config/session.php` sudah hardcode `file` sebagai pengaman.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# CATATAN: filesystem Railway bersifat ephemeral — file upload hilang setiap
# redeploy. Pasang Railway Volume di /app/storage/app, atau pindah ke S3/R2.
FILESYSTEM_DISK=local

# Butuh tabel jobs/cache dari migrasi bawaan Laravel (sudah ada di repo).
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ganti dengan key production saat go-live (dashboard.midtrans.com → Settings → Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com

L5_SWAGGER_GENERATE_ALWAYS=false

VITE_APP_NAME="${APP_NAME}"
